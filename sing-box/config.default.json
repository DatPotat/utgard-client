{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "logs/sing-box.log"
  },

  "dns": {
    "servers": [
      { "tag": "local", "type": "local" },
      {
        "tag": "doh",
        "type": "h3",
        "server": "dns.google",
        "server_port": 443,
        "path": "/dns-query",
        "domain_resolver": "local"
      }
    ],
    "rules": [
      { "rule_set": ["general"], "server": "doh" }
    ],
    "final": "local",
    "strategy": "ipv4_only"
  },

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.30.30.1/30"],
      "mtu": 1430,
      "auto_route": true,
      "strict_route": false,
      "stack": "system"
    }
  ],

  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "local",
    "final": "direct",
    "rules": []
  }
}
